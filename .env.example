# OpenAI-compatible provider
MINUTES_LLM_PROVIDER=openai_compatible
MINUTES_LLM_MODEL=your-model-name
MINUTES_LLM_BASE_URL=https://api.openai.com/v1
MINUTES_LLM_API_KEY=your-api-key

# Optional tuning
MINUTES_LLM_TEMPERATURE=0.1
MINUTES_LLM_MAX_TOKENS=4000
MINUTES_LLM_TIMEOUT=120

# Anthropic example:
# MINUTES_LLM_PROVIDER=anthropic
# MINUTES_LLM_MODEL=claude-haiku-4-5
# MINUTES_LLM_API_KEY=your-api-key

# Volcengine ASR example:
MINUTES_ASR_PROVIDER=volcengine_asr
MINUTES_ASR_MODEL=bigmodel
MINUTES_ASR_BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
MINUTES_ASR_API_KEY=your-volcengine-asr-api-key
